# Restricted key (rk_...) with Checkout Sessions write and, if you expand
# PaymentIntents on the return page, Payment Intents read.
# Never commit a real key. Set these in the Render dashboard.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional. Render sets RENDER_EXTERNAL_URL for the service.
# Used for Checkout return URLs when you want to override the request host.
# PUBLIC_BASE_URL=http://localhost:3000
